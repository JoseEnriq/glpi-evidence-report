# Copy this file to ".env" and fill it in. .env is in .gitignore:
# NEVER commit the file with real tokens, nor send it by e-mail or chat.
#
# For each instance in config.toml, the API TOKEN of the user who runs the
# report. In GLPI: user menu > My settings > Remote access keys >
# "API token" > Regenerate > Save (it is not the "Personal token").
# The user needs a profile that can see every ticket and attachment
# (e.g. Observer or Read-Only on the root entity, recursive).
GLPI_MAIN_API_USER_TOKEN=
# GLPI_SECONDARY_API_USER_TOKEN=

# Optional — application token (App-Token) of the API client, if it has one
# (Setup > General > API > API client).
# GLPI_MAIN_API_APP_TOKEN=

# Optional — overrides the URL from config.toml for one instance.
# GLPI_MAIN_URL=

# Optional — 0 disables HTTPS certificate verification (only for internal/
# self-signed certificates; prefer keeping 1).
# GLPI_VERIFY_SSL=1

# Optional — PDF only. By default LibreOffice is searched in the PATH and in
# the default install folders.
# LIBREOFFICE_PATH=
